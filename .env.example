# PostgreSQL connection string (Supabase transaction pooler, port 6543)
SUPABASE_DB_URL=

# OpenAI API key for text-embedding-3-small
OPENAI_API_KEY=

# AWS credentials for Bedrock (Claude Sonnet metadata extraction)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: override Bedrock model (default: us.anthropic.claude-sonnet-4-6)
BEDROCK_MODEL_ID=
